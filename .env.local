# Local test database - SQLite
SQL_DSN=test_local.db

# Server config
PORT=3000
SESSION_SECRET=test-secret-key-local-dev-only

# Redis (optional for local, will fallback to memory cache)
REDIS_CONN_STRING=

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Initial root user
ROOT_USER_EMAIL=admin@test.local
ROOT_USER_PASSWORD=admin123
