# Database
SQL_DSN=postgresql://user:password@localhost:5432/resuelve

# Security
SESSION_SECRET=your-random-secret-here
JWT_SECRET=your-jwt-secret-here
WEBHOOK_SECRET=your-webhook-secret-here

# Redis
REDIS_CONN_STRING=redis://localhost:6379

# Server
PORT=3000
SERVER_ADDRESS=0.0.0.0:3000

# Tokens
GENERATE_DEFAULT_TOKEN=false

# CORS
# CORS_ALLOW_ORIGINS=https://your-domain.com

# Trusted Proxies
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Payment Gateway - Flow (WebPay CLP)
FLOW_API_KEY=your-flow-api-key
FLOW_SECRET_KEY=your-flow-secret-key

# Payment Gateway - NOWPayments (USDT Crypto)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# Payment Configuration
PAYMENT_CALLBACK_URL=https://resuelve-api.lat/api/flow/notify
PAYMENT_RETURN_URL=https://resuelve-api.lat/console/wallet
PAYMENT_SUCCESS_URL=https://resuelve-api.lat/console/wallet
PAYMENT_CANCEL_URL=https://resuelve-api.lat/console/wallet
EPAY_KEY=your-epay-signing-key

# Payment Feature Flags
USDT_ENABLED=false
